# Production Environment Variables for Vercel
# Copy these into your Vercel project: Settings -> Environment Variables

NODE_ENV=production
PORT=3000
USE_IN_MEMORY_DB=true

# Frontend Origin - Update this with your actual Vercel domain
# Example: https://madarsa-website.vercel.app
FRONTEND_ORIGIN=https://yourdomain.vercel.app

# Auth - REQUIRED for production
AUTH_SECRET=change-this-to-a-long-random-secret-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123
HEAD_SIGNUP_CODE=DarulHudaHead2026

# Email Configuration - REQUIRED for contact form and password reset
# For Gmail: use an App Password (not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-email@gmail.com

# Password Reset Token TTL (in seconds)
PASSWORD_RESET_TOKEN_TTL=3600
