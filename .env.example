# Backend Configuration
PORT=5000
NODE_ENV=production

# Frontend Configuration
FRONTEND_ORIGIN=https://yourdomain.com

# Auth
AUTH_SECRET=change-this-to-a-long-random-secret-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123
HEAD_SIGNUP_CODE=DarulHudaHead2026

# Database Configuration (if using MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=madarsa

# Use in-memory database for development/testing (auto-enabled on Vercel)
USE_IN_MEMORY_DB=false

# Email Configuration (required for contact form and password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@madarsa.com

# Password reset token TTL (in seconds)
PASSWORD_RESET_TOKEN_TTL=3600
